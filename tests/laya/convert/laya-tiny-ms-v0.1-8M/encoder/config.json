{
  "architectures": [
    "ModernBertForMaskedLM"
  ],
  "bos_token_id": 2,
  "cls_token_id": 1,
  "eos_token_id": 1,
  "global_attn_every_n_layers": 3,
  "hidden_activation": "gelu",
  "hidden_size": 32,
  "intermediate_size": 16,
  "layer_norm_eps": 1e-05,
  "local_attention": 16,
  "mask_token_id": 4,
  "max_position_embeddings": 128,
  "model_type": "modernbert",
  "norm_eps": 1e-05,
  "num_attention_heads": 4,
  "num_hidden_layers": 2,
  "pad_token_id": 0,
  "rope_parameters": {
    "full_attention": {
      "rope_theta": 160000,
      "rope_type": "default"
    },
    "sliding_attention": {
      "rope_theta": 160000,
      "rope_type": "default"
    }
  },
  "sep_token_id": 1,
  "tie_word_embeddings": true,
  "vocab_size": 64
}
