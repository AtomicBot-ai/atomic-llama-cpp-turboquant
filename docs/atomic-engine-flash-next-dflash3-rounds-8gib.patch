+// Single-slot measurement: keep disjoint wall-clock intervals in memory until the last ID is queued.
+namespace {
+struct decode_event { const char * name; int arg; int64_t begin; int64_t end; };
+struct decode_trace {
+    decode_event events[1024];
+    size_t count = 0;
+    bool active = false;
+    bool fence = false;
+    bool first_draft = false;
+    void add(const char * name, int arg, int64_t begin, int64_t end) {
+        GGML_ASSERT(count < 1024);
+        events[count++] = {name, arg, begin, end};
+    }
+    void token(int n) {
+        if (n == 1) {
+            count = 0;
+            active = true;
+            fence = std::getenv("FLASH_PHASE_FENCE") != nullptr;
+            first_draft = true;
+        }
+        if (active) {
+            const int64_t t = ggml_time_us();
+            add("emit", n, t, t);
+            if (n == 64) {
+                active = false;
+                for (size_t i = 0; i < count; ++i) {
+                    const auto & e = events[i];
+                    std::fprintf(stderr, "DECODE_PHASE %s %d %" PRId64 " %" PRId64 "\n",
+                            e.name, e.arg, e.begin, e.end);
+                }
+            }
+        }
+    }
+};
+static thread_local decode_trace phases;
+struct decode_span {
+    const char * name;
+    int arg;
+    int64_t begin;
+    decode_span(const char * name, int arg = 0) : name(name), arg(arg),
+        begin(phases.active ? ggml_time_us() : 0) {}
+    ~decode_span() { if (begin) { phases.add(name, arg, begin, ggml_time_us()); } }
+};
+} // namespace
 
 constexpr int HTTP_POLLING_SECONDS = 1;
 
