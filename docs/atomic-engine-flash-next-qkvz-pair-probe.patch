 int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
+    const int marker = ctx->node(idx)->op_params[15];
+    if (marker >= 0x515a00 && marker < 0x515a40 && flash_mv_pair(ctx, idx)) {
+        return 2;
+    }
