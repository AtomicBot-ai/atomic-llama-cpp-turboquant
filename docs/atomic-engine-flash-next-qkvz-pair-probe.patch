+struct flash_mv_format {
+    int16_t id;
+    int16_t rows;
+    size_t scratch;
+};
+
+static flash_mv_format flash_mv_type(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_K:   return {0, N_R0_Q4_K, 0};
+        case GGML_TYPE_Q5_K:   return {1, N_R0_Q5_K, 0};
+        case GGML_TYPE_Q6_K:   return {2, N_R0_Q6_K, 0};
+        case GGML_TYPE_IQ4_XS: return {3, N_R0_IQ4_XS, 32*sizeof(float)};
+        case GGML_TYPE_IQ3_S:  return {4, N_R0_IQ3_S, 512*4};
+        default:               return {-1, 0, 0};
+    }
+}
+
+static bool flash_mv_disjoint(const ggml_tensor * a, const ggml_tensor * b) {
+    const auto x = ggml_metal_get_buffer_id(a);
+    const auto y = ggml_metal_get_buffer_id(b);
+    return x.metal != y.metal || (x.offs <= y.offs ?
+            y.offs - x.offs >= ggml_nbytes(a) : x.offs - y.offs >= ggml_nbytes(b));
+}
+
+static bool flash_mv_pair(ggml_metal_op_t ctx, int idx) {
+    if (!ctx->use_fusion() || idx + 1 >= ctx->n_nodes()) {
+        return false;
+    }
+    const auto * q = ctx->node(idx);
+    const auto * z = ctx->node(idx+1);
+    const auto * x = q->src[1];
+    if (z->op != GGML_OP_MUL_MAT || z->op_params[15] != -q->op_params[15] ||
+            !(z->flags & GGML_TENSOR_FLAG_COMPUTE) || z->src[1] != x ||
+            x->type != GGML_TYPE_F32 || !ggml_is_vector(x) || !ggml_is_contiguous(x) || x->ne[0] != 2560 ||
+            q->ne[0] != 10240 || z->ne[0] != 6144) {
+        return false;
+    }
+    const ggml_tensor * ops[] = {q,z};
+    ggml_metal_kargs_mul_mv args[2];
+    flash_mv_format formats[2];
+    int groups = 0;
+    constexpr short nsg = 2;
+    for (int i = 0; i < 2; ++i) {
+        const auto * op = ops[i];
+        const auto * w = op->src[0];
+        const auto fmt = flash_mv_type(w->type);
+        if (fmt.id < 0 || !ggml_is_matrix(w) || !ggml_is_contiguous(w) || !ggml_is_vector(op) ||
+                op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op) || w->ne[1] % (fmt.rows*nsg) ||
+                !flash_mv_disjoint(q,w) || !flash_mv_disjoint(z,w) || !flash_mv_disjoint(op,x)) {
+            return false;
+        }
+        formats[i] = fmt;
+        args[i] = {(int32_t)w->ne[0], (int32_t)w->ne[1], 1, w->nb[0], w->nb[1], w->nb[2], w->nb[3],
+                   (int32_t)x->ne[0], 1, 1, x->nb[0], x->nb[1], x->nb[2], x->nb[3],
+                   (int32_t)op->ne[0], 1, fmt.rows, 1, 1};
+        groups += w->ne[1] / (nsg*fmt.rows);
+    }
+    if (!flash_mv_disjoint(q,z)) {
+        return false;
+    }
+
+    const char * base = "kernel_mul_mv_flash_qkvz";
+    char name[80];
+    snprintf(name, sizeof(name), "%s_%d_%d", base, formats[0].id, formats[1].id);
+    auto pipeline = ggml_metal_library_get_pipeline(ctx->lib, name);
+    if (!pipeline.pipeline) {
+        auto cv = ggml_metal_cv_init();
+        ggml_metal_cv_set_int16(cv, nsg, FC_MUL_MV);
+        ggml_metal_cv_set_int16(cv, 1, FC_MUL_MV + 2);
+        ggml_metal_cv_set_int16(cv, 1, FC_MUL_MV + 3);
+        ggml_metal_cv_set_int16(cv, 1, FC_MUL_MV + 4);
+        ggml_metal_cv_set_bool(cv, false, FC_MUL_MV + 5);
+        ggml_metal_cv_set_int16(cv, formats[0].id, FC_MUL_MV + 6);
+        ggml_metal_cv_set_int16(cv, formats[1].id, FC_MUL_MV + 7);
+        pipeline = ggml_metal_library_compile_pipeline(ctx->lib, base, name, cv);
+        ggml_metal_cv_free(cv);
+        if (!pipeline.pipeline) {
+            return false;
+        }
+    }
+
+    // The ordinary encoder tested q. z introduces a second read and write.
+    if (!ggml_metal_op_concurrency_check(ctx, z)) {
+        ggml_metal_op_concurrency_reset(ctx);
+    }
+    auto enc = ctx->enc;
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes(enc, args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(q->src[0]), 1);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(z->src[0]), 2);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(x), 3);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(q), 4);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(z), 5);
+    ggml_metal_encoder_set_threadgroup_memory_size(enc, std::max(formats[0].scratch,formats[1].scratch), 0);
+    ggml_metal_encoder_dispatch_threadgroups(enc, groups, 1, 1, 32, nsg, 1);
+    // One line per layer during warmup. No per-token counters or GPU timestamps.
+    static std::atomic<uint64_t> seen{0};
+    const int layer = q->op_params[15] - 0x515a00;
+    const uint64_t bit = UINT64_C(1) << layer;
+    if (!(seen.load(std::memory_order_relaxed) & bit) && !(seen.fetch_or(bit) & bit)) {
+        fprintf(stderr, "FLASH_QKVZ layer=%d qkv=%s z=%s\n", layer, ggml_type_name(q->src[0]->type), ggml_type_name(z->src[0]->type));
+    }
+    return true;
+}
