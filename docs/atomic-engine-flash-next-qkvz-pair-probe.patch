+// The row arithmetic and simd reductions are the ordinary one-token kernels.
+// Every thread in a threadgroup takes the same side, including its barriers.
+static inline void flash_quant_projection(short format, constant ggml_metal_kargs_mul_mv & args,
+        device const char * weight, device const char * x, device char * y,
+        threadgroup char * scratch, uint3 pos, ushort lane, ushort simd) {
+    switch (format) {
+        case 0: kernel_mul_mv_q4_K_f32_impl<N_R0_Q4_K, constant ggml_metal_kargs_mul_mv &>(args, weight, x, y, scratch, pos, lane, simd); break;
+        case 1: kernel_mul_mv_q5_K_f32_impl<N_R0_Q5_K, constant ggml_metal_kargs_mul_mv &>(args, weight, x, y, scratch, pos, lane, simd); break;
+        case 2: kernel_mul_mv_q6_K_f32_impl<N_R0_Q6_K, constant ggml_metal_kargs_mul_mv &>(args, weight, x, y, scratch, pos, lane, simd); break;
+        case 3: kernel_mul_mv_iq4_xs_f32_impl<N_R0_IQ4_XS, constant ggml_metal_kargs_mul_mv &>(args, weight, x, y, scratch, pos, lane, simd); break;
+        case 4: kernel_mul_mv_iq3_s_f32_impl<N_R0_IQ3_S, constant ggml_metal_kargs_mul_mv &>(args, weight, x, y, scratch, pos, lane, simd); break;
+    }
+}
+
+kernel void kernel_mul_mv_flash_qkvz(
+        constant ggml_metal_kargs_mul_mv * args [[buffer(0)]],
+        device const char * wq [[buffer(1)]], device const char * wz [[buffer(2)]],
+        device const char * x [[buffer(3)]],
+        device char * q [[buffer(4)]], device char * z [[buffer(5)]],
+        threadgroup char * scratch [[threadgroup(0)]],
+        uint3 pos [[threadgroup_position_in_grid]], ushort lane [[thread_index_in_simdgroup]],
+        ushort simd [[simdgroup_index_in_threadgroup]]) {
+    const uint split = args[0].ne01 / (FC_mul_mv_nsg * args[0].nr0);
+    if (pos.x < split) {
+        flash_quant_projection(qkv_format, args[0], wq, x, q, scratch, pos, lane, simd);
+    } else {
+        pos.x -= split;
+        flash_quant_projection(z_format, args[1], wz, x, z, scratch, pos, lane, simd);
+    }
+}
