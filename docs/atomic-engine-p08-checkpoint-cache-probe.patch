+        throw std::runtime_error("MTP cache counters unavailable");
+    }
+    return {{"hits", stats.hits}, {"misses", stats.misses}, {"evictions", stats.evictions},
+        {"logical_read_bytes", stats.logical_read_bytes}, {"budget_request_id", budget.request_id}};
+}
 
