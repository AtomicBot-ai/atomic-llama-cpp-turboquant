    "wide_probe_binary_sha256": "787279f28207e0aaa3662397d68178abae5c1c07c6f56c6d3c2bc7a0dc041aac",
    "notes": "Apply the patch to a separate copy of the measured source tree and build the static Release Metal llama-server target. The server never reads the reference. The size-aware victim choice is enabled only on the first non-prompt batch of the 64-output request. The gated wide feature variant lets the existing admission/fallback logic try its partial wide prefill. Use one process per run. Prior local changes to the Flash Next wide prefill are present in all builds.",
    "core_patch": "--- a/src/llama-expert-store.cpp\n+++ b/src/llama-expert-store.cpp\n@@ -17,6 +17,11 @@\n #include <mutex>\n #include <stdexcept>\n #include <utility>\n+\n+// Single-request verifier sets this switch after prefill, before timed decode.\n+static bool flash_verify_size_lru = false;\n+void flash_verify_enable_size_lru();\n+void flash_verify_enable_size_lru() { flash_verify_size_lru = true; }\n \n namespace {\n \n@@ -301,7 +306,25 @@\n         return bytes;\n     }\n \n+    // The verifier fixture uses six 64 KiB-aligned Metal size classes.\n+    // Other geometries fall back to the existing LRU admission policy.\n+    static constexpr size_t slot_alignment = 64 * 1024;\n+    std::array<entry *, 16> oldest_size {};\n+\n+    static bool indexed_size(size_t bytes) {\n+        return bytes && bytes <= 16 * slot_alignment && bytes % slot_alignment == 0;\n+    }\n+\n+    static entry * next_size(entry * start, size_t bytes) {\n+        while (start && start->buffer_charge.size() != bytes) { start = start->newer; }\n+        return start;\n+    }\n+\n     void unlink_lru(entry & e) {\n+        if (flash_verify_size_lru && !history && indexed_size(e.buffer_charge.size())) {\n+            auto & first = oldest_size[e.buffer_charge.size() / slot_alignment - 1];\n+            if (first == &e) { first = next_size(e.newer, e.buffer_charge.size()); }\n+        }\n         if (e.older) { e.older->newer = e.newer; }\n         else { lru_first[e.frequency_class] = e.newer; }\n         if (e.newer) { e.newer->older = e.older; }\n@@ -328,7 +351,7 @@\n         return candidate;\n     }\n \n-    std::shared_ptr<entry> take_victim() {\n+    std::shared_ptr<entry> take_victim(size_t preferred_bytes = 0) {\n         llama_expert_timer timer(profile ? &profile->eviction_search_ns : nullptr);\n         entry * chosen = nullptr;\n         if (history) {\n@@ -380,6 +403,15 @@\n             }\n         } else {\n             chosen = oldest_unpinned(0);\n+            if (indexed_size(preferred_bytes)) {\n+                auto & first = oldest_size[preferred_bytes / slot_alignment - 1];\n+                if (!first) { first = next_size(lru_first[0], preferred_bytes); }\n+                auto * candidate = first;\n+                while (candidate && (candidate->pins || candidate->retiring)) {\n+                    candidate = next_size(candidate->newer, preferred_bytes);\n+                }\n+                if (candidate) { chosen = candidate; }\n+            }\n         }\n         if (!chosen) { return {}; }\n         auto victim = entries.find(chosen->key);\n@@ -974,7 +1006,7 @@\n             charges = pimpl->reserve(arena_bytes, buffer_bytes, data_bytes);\n             if (charges.complete()) { break; }\n             charges = {};\n-            auto victim = pimpl->take_victim();\n+            auto victim = pimpl->take_victim(flash_verify_size_lru ? buffer_bytes : 0);\n             if (!victim) {\n                 // Tight budgets must not fail merely because spares are held.\n                 if (pimpl->release_recycled()) { continue; }\n--- a/src/llama-context-atomic.cpp\n+++ b/src/llama-context-atomic.cpp\n@@ -43,7 +43,8 @@\n     }\n     const size_t cap = target->memory_contract->ledger->snapshot(llama_memory_domain::host).requested;\n     const auto & hp = target->hparams;\n-    const bool flash = cap == (size_t(18) << 30) && target->arch == LLM_ARCH_QWEN4EXP &&\n+    const bool flash8 = cap == (size_t(8) << 30) && std::getenv(\"FLASH_LIVE_DRAFT\");\n+    const bool flash = (flash8 || cap == (size_t(18) << 30)) && target->arch == LLM_ARCH_QWEN4EXP &&\n         hp.n_layer() == 48 && target->streamed_ple;\n     const bool qwen35 = (target->memory_contract->qwen35_profile_layers || cap == (size_t(8) << 30)) && target->arch == LLM_ARCH_QWEN35MOE &&\n         hp.n_layer() == 40 && hp.n_embd == 2048 && hp.n_expert == 256 && hp.n_expert_used_max() == 8;\n@@ -55,7 +56,7 @@\n     // host staging for saving or loading the draft appendix before evaluation.\n     auto & contract = *target->memory_contract;\n     contract.draft_slot_staging = contract.ledger->reserve(llama_memory_domain::host,\n-            llama_memory_category::io, llama_atomic_dflash2_slot_staging_bytes(qwen35 ? 4096 : 1024));\n+            llama_memory_category::io, llama_atomic_dflash2_slot_staging_bytes((qwen35 || flash8) ? 4096 : 1024));\n     if (!contract.draft_slot_staging) { return false; }\n     if (qwen35 && contract.qwen35_profile_layers == 40 &&\n             (cap == (size_t(24) << 30) || cap == (size_t(26) << 30))) {\n--- a/src/llama-context.cpp\n+++ b/src/llama-context.cpp\n@@ -196,7 +196,8 @@\n                  model.n_gpu_layers() > model.hparams.n_layer_all || !params.op_offload)) {\n             throw std::runtime_error(\"CUDA boundary reduction requires partially offloaded LFM2 MoE with op offload\");\n         }\n-        const bool dflash_profile = (model.arch == LLM_ARCH_QWEN4EXP && params.n_ctx == 1024) ||\n+        const bool dflash_profile = (model.arch == LLM_ARCH_QWEN4EXP && (params.n_ctx == 1024 ||\n+            (model.memory_contract->dflash2_target && std::getenv(\"FLASH_LIVE_DRAFT\") && params.n_ctx == 4096 && params.n_batch == 4096))) ||\n             (model.arch == LLM_ARCH_QWEN35MOE && params.n_ctx == 4096 && params.n_batch == 4096);\n         const bool rollback_allowed = model.memory_contract->dflash2_target && dflash_profile &&\n             params.n_ubatch == 8 && params.n_rs_seq < params.n_ubatch - 1;\n--- a/tools/server/server-context.cpp\n+++ b/tools/server/server-context.cpp\n@@ -1,3 +1,4 @@\n+extern void flash_verify_enable_size_lru();\n #include \"atomic-budget.h\"\n #include \"atomic-dflash-depth.h\"\n #include \"server-context.h\"\n@@ -4860,6 +4861,15 @@\n                  batch.slot_batched->n_remaining() > params_base.speculative.draft.n_max);\n         int64_t verify_us = 0;\n         queue_tasks.yield_to_queue([&]() {\n+            // Single measured request, following an eight-token serial warmup.\n+            // Activate only after prefill so both policies start with the same cache.\n+            static const bool size_lru = std::getenv(\"FLASH_LIVE_SIZE_LRU\") != nullptr;\n+            static bool enabled = false;\n+            if (size_lru && !enabled && !batch.tokens[off].is_prompt && batch.slot_batched &&\n+                    batch.slot_batched->task->params.n_predict == 64) {\n+                flash_verify_enable_size_lru();\n+                enabled = true;\n+            }\n             const int64_t verify_start = measure_verify ? ggml_time_us() : 0;\n             if (params_base.engine_budget && batch.tokens[off].is_prompt) {\n                 // Managed mode has one slot. Use the same uncached prefill size\n"
