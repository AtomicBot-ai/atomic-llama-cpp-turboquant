+            ggml_is_contiguous(op->src[0]) && ggml_is_contiguous(op->src[1]) &&
+            ggml_is_contiguous(op)) {
+        return ggml_metal_op_q8_row_probe(ctx, op);
+    }
 
     ggml_metal_library_t lib = ctx->lib;
     ggml_metal_encoder_t enc = ctx->enc;
