+int ggml_metal_q8_row_probe(bool enabled) {
+    return q8_row_probe.exchange(enabled ? 0 : -1);
+}
+
+static int ggml_metal_op_q8_row_probe(ggml_metal_op_t ctx, const ggml_tensor * op) {
+    // Retain the one-row dispatch parameters and vary only the buffer offsets.
+    const auto * w = op->src[0];
+    const auto * x = op->src[1];
+    ggml_tensor row_x = *x;
+    row_x.ne[1] = 1;
+    ggml_tensor row_op = *op;
+    row_op.ne[1] = 1;
+    row_op.src[1] = &row_x;
+    const auto pipeline = ggml_metal_library_get_pipeline_mul_mv(ctx->lib, &row_op);
+    ggml_metal_kargs_mul_mv args = {
+        /*.ne00 =*/ int32_t(w->ne[0]),
+        /*.ne01 =*/ int32_t(w->ne[1]),
+        /*.ne02 =*/ 1,
+        /*.nb00 =*/ w->nb[0],
+        /*.nb01 =*/ w->nb[1],
+        /*.nb02 =*/ w->nb[2],
+        /*.nb03 =*/ w->nb[3],
+        /*.ne10 =*/ int32_t(x->ne[0]),
+        /*.ne11 =*/ 1,
+        /*.ne12 =*/ 1,
+        /*.nb10 =*/ x->nb[0],
+        /*.nb11 =*/ x->nb[1],
+        /*.nb12 =*/ x->nb[2],
+        /*.nb13 =*/ x->nb[3],
+        /*.ne0  =*/ int32_t(op->ne[0]),
+        /*.ne1  =*/ 1,
+        /*.nr0  =*/ pipeline.nr0,
+        /*.r2   =*/ 1,
+        /*.r3   =*/ 1,
+    };
+    auto input = ggml_metal_get_buffer_id(x);
+    auto output = ggml_metal_get_buffer_id(op);
+    ggml_metal_encoder_set_pipeline(ctx->enc, pipeline);
+    ggml_metal_encoder_set_bytes(ctx->enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer(ctx->enc, ggml_metal_get_buffer_id(w), 1);
+    ggml_metal_encoder_set_threadgroup_memory_size(ctx->enc, pipeline.smem, 0);
+    for (int row = 0; row < 2; ++row) {
+        ggml_metal_encoder_set_buffer(ctx->enc, input, 2);
+        ggml_metal_encoder_set_buffer(ctx->enc, output, 3);
+        ggml_metal_encoder_dispatch_threadgroups(ctx->enc,
+            (op->ne[0] + pipeline.nr0 - 1)/pipeline.nr0, 1, 1, 32, pipeline.nsg, 1);
+        input.offs += x->nb[1];
+        output.offs += op->nb[1];
+    }
+    q8_row_probe.fetch_add(1, std::memory_order_relaxed);
+    return 1;
+}
