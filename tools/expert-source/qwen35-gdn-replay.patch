+// Fixed Qwen3.6-35B geometry. Retain the GDN state before the pending block
+// and ping-pong between two histories of the exact recurrent inputs.
+kernel void kernel_qwen_gdn_replay(
+        constant ggml_metal_kargs_gated_delta_net & args [[buffer(0)]],
+        device const char * q [[buffer(1)]],
+        device const char * k [[buffer(2)]],
+        device const char * v [[buffer(3)]],
+        device const float * g [[buffer(4)]],
+        device const float * beta [[buffer(5)]],
+        device float * state [[buffer(6)]],
+        device float * output [[buffer(7)]],
+        device const int * replay [[buffer(9)]],
+        device float * history [[buffer(10)]],
+        uint3 group [[threadgroup_position_in_grid]],
+        uint3 thread_id [[thread_position_in_threadgroup]]) {
+    constexpr uint width = 128, heads = 32, key_heads = 16, tile = 4, max_rows = 7;
+    constexpr uint value_offset = width * key_heads;
+    constexpr uint gate_offset = value_offset + width * heads;
+    constexpr uint beta_offset = gate_offset + heads;
+    constexpr uint row_size = beta_offset + heads;
+
+    const uint lane = thread_id.x;
+    const uint row = group.x * tile + thread_id.y;
+    const uint head = group.y;
+    const uint q_head = head % args.ne01;
+    const uint k_head = head % args.ne11;
+    state += (head * width + row) * width;
+
+    float ls[tile];
+    FOR_UNROLL (short j = 0; j < tile; ++j) {
+        ls[j] = replay[2] ? 0.f : state[lane * tile + j];
+    }
+
+    device const float * prev = history + replay[1] * max_rows * row_size;
+    for (int t = 0; t < replay[0]; ++t) {
+        device const float * input = prev + t * row_size;
+        device const float * key = input + k_head * width;
+        float s_k = 0.0f;
+        const float g_exp = exp(input[gate_offset + head]);
+        FOR_UNROLL (short j = 0; j < tile; ++j) {
+            const short is = lane * tile + j;
+            ls[j] *= g_exp;
+            s_k += ls[j]*key[is];
+        }
+        s_k = simd_sum(s_k);
+        const float d = (input[value_offset + head * width + row] - s_k) * input[beta_offset + head];
+        FOR_UNROLL (short j = 0; j < tile; ++j) {
+            const short is = lane * tile + j;
+            ls[j] += key[is]*d;
+        }
+    }
+    const bool retain = args.ne22 <= max_rows;
+    if (retain) {
+        FOR_UNROLL (short j = 0; j < tile; ++j) {
+            state[lane * tile + j] = ls[j];
+        }
+    }
+
+    device const float * q_ptr = (device const float *)(q + q_head * args.nb01);
+    device const float * k_ptr = (device const float *)(k + k_head * args.nb11);
+    device const float * v_ptr = (device const float *)(v + head * args.nb21);
+    device float * next = history + (1 - replay[1]) * max_rows * row_size;
+    const float scale = 1.f / sqrt(float(width));
+
+    for (short t = 0; t < args.ne22; t++) {
+        const float g_input = g[t * heads + head];
+        const float b_input = beta[t * heads + head];
+        float s_k = 0.0f;
+        const float g_exp = exp(g_input);
+        FOR_UNROLL (short j = 0; j < tile; ++j) {
+            const short is = lane * tile + j;
+            ls[j] *= g_exp;
+            s_k += ls[j]*k_ptr[is];
+        }
+        s_k = simd_sum(s_k);
+        const float d = (v_ptr[row] - s_k)*b_input;
+        float y = 0.0f;
+        FOR_UNROLL (short j = 0; j < tile; ++j) {
+            const short is = lane * tile + j;
+            ls[j] += k_ptr[is]*d;
+            y += ls[j]*q_ptr[is];
+        }
+        y = simd_sum(y);
+        if (lane == 0) {
+            output[(t * heads + head) * width + row] = y*scale;
+        }
+
+        if (retain) {
+            device float * input = next + t * row_size;
+            if (row == 0 && head < key_heads) {
+                FOR_UNROLL (short j = 0; j < tile; ++j) {
+                    const short is = lane * tile + j;
+                    input[head * width + is] = k_ptr[is];
+                }
+            }
+            if (lane == 0) {
+                input[value_offset + head * width + row] = v_ptr[row];
+                if (row == 0) {
+                    input[gate_offset + head] = g_input;
+                    input[beta_offset + head] = b_input;
+                }
+            }
+        }
+        q_ptr += args.ns02;
+        k_ptr += args.ns12;
+        v_ptr += args.ns22;
+    }
+    if (!retain) {
+        FOR_UNROLL (short j = 0; j < tile; ++j) {
+            state[lane * tile + j] = ls[j];
+        }
+    }
+}
