+#include "common.h"
+
+// Recurrence from gated_delta_net.metal at 31953bcf7. Keep the FP32
+// accumulation and SIMD reduction order in sync with the scalar-gate path.
+// Each SIMD group owns one row of an FP32 128 x 128 state matrix.
+static inline void gdn_replay_prefix(
+        thread float (&state)[4],
+        device const float * history,
+        constant ggml_metal_gdn_replay_layout & layout,
+        int accepted, uint lane, uint row, uint head) {
+    const uint value_offset = 128 * layout.key_heads;
+    const uint gate_offset = value_offset + 128 * layout.heads;
+    const uint beta_offset = gate_offset + layout.heads;
+    const uint row_size = beta_offset + layout.heads;
+    for (int t = 0; t < accepted; ++t) {
+        device const float * input = history + t * row_size;
+        device const float * key = input + (head % layout.key_heads) * 128;
+        const float gate = exp(input[gate_offset + head]);
+        float s_k = 0.0f;
+        FOR_UNROLL (short j = 0; j < 4; ++j) {
+            const uint is = lane * 4 + j;
+            state[j] *= gate;
+            s_k += state[j]*key[is];
+        }
+        s_k = simd_sum(s_k);
+        const float d = (input[value_offset + head * 128 + row] - s_k) * input[beta_offset + head];
+        FOR_UNROLL (short j = 0; j < 4; ++j) {
+            state[j] += key[lane * 4 + j]*d;
+        }
+    }
+}
+
+template<bool RETAIN>
+kernel void kernel_gated_delta_net_replay_impl(
+        constant ggml_metal_kargs_gated_delta_net & args [[buffer(0)]],
+        device const char * q [[buffer(1)]],
+        device const char * k [[buffer(2)]],
+        device const char * v [[buffer(3)]],
+        device const float * g [[buffer(4)]],
+        device const float * beta [[buffer(5)]],
+        device float * state [[buffer(6)]],
+        device float * output [[buffer(7)]],
+        device const int * replay [[buffer(9)]],
+        device float * history [[buffer(10)]],
+        constant ggml_metal_gdn_replay_layout & layout [[buffer(11)]],
+        uint3 group [[threadgroup_position_in_grid]],
+        uint3 thread_id [[thread_position_in_threadgroup]]) {
+    const uint lane = thread_id.x;
+    const uint row = group.x * 4 + thread_id.y;
+    const uint head = group.y;
+    const uint q_head = head % args.ne01;
+    const uint k_head = head % layout.key_heads;
+    const uint value_offset = 128 * layout.key_heads;
+    const uint gate_offset = value_offset + 128 * layout.heads;
+    const uint beta_offset = gate_offset + layout.heads;
+    const uint row_size = beta_offset + layout.heads;
+    const uint bank_size = layout.history_rows * row_size;
+    state += (head * 128 + row) * 128;
+
+    float ls[4];
+    FOR_UNROLL (short j = 0; j < 4; ++j) {
+        ls[j] = replay[2] ? 0.0f : state[lane * 4 + j];
+    }
+    gdn_replay_prefix(ls, history + replay[1] * bank_size, layout, replay[0], lane, row, head);
+
+    // A short block leaves the accepted starting state and its provisional
+    // inputs. Long prompt batches leave only their final state.
+    if (RETAIN) {
+        FOR_UNROLL (short j = 0; j < 4; ++j) {
+            state[lane * 4 + j] = ls[j];
+        }
+    }
+
+    device const float * q_ptr = (device const float *)(q + q_head * args.nb01);
+    device const float * k_ptr = (device const float *)(k + k_head * args.nb11);
+    device const float * v_ptr = (device const float *)(v + head * args.nb21);
+    device float * next = history + (1 - replay[1]) * bank_size;
+    device const float * g_ptr = g + head;
+    device const float * b_ptr = beta + head;
+    device float * out = output + head * 128 + row;
+    const float scale = 1.0f / sqrt(128.0f);
