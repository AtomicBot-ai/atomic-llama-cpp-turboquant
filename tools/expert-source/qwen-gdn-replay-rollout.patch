+    for (int t = 0; t < args.ne22; ++t) {
+        const float g_input = *g_ptr;
+        const float b_input = *b_ptr;
+        const float gate = exp(g_input);
+        float s_k = 0.0f;
+        FOR_UNROLL (short j = 0; j < 4; ++j) {
+            const uint is = lane * 4 + j;
+            ls[j] *= gate;
+            s_k += ls[j]*k_ptr[is];
+        }
+        s_k = simd_sum(s_k);
+        const float d = (v_ptr[row] - s_k)*b_input;
+        float y = 0.0f;
+        FOR_UNROLL (short j = 0; j < 4; ++j) {
+            const uint is = lane * 4 + j;
+            ls[j] += k_ptr[is]*d;
+            y += ls[j]*q_ptr[is];
+        }
+        y = simd_sum(y);
+        if (lane == 0) {
+            out[t * layout.heads * 128] = y*scale;
+        }
+
+        if (RETAIN) {
+            device float * input = next + t * row_size;
+            if (row == 0 && head < uint(layout.key_heads)) {
+                FOR_UNROLL (short j = 0; j < 4; ++j) {
+                    const uint is = lane * 4 + j;
+                    input[head * 128 + is] = k_ptr[is];
+                }
+            }
+            if (lane == 0) {
+                input[value_offset + head * 128 + row] = v_ptr[row];
+                if (row == 0) {
+                    input[gate_offset + head] = g_input;
+                    input[beta_offset + head] = b_input;
+                }
+            }
+        }
+        q_ptr += args.ns02;
+        k_ptr += args.ns12;
+        v_ptr += args.ns22;
+        g_ptr += layout.heads;
+        b_ptr += layout.heads;
+    }
+    if (!RETAIN) {
+        FOR_UNROLL (short j = 0; j < 4; ++j) {
+            state[lane * 4 + j] = ls[j];
+        }
+    }
