+bool ggml_metal_gdn_replay_export(ggml_metal_device_t dev, const struct ggml_tensor * state,
+        const struct ggml_tensor * history, int heads, int key_heads, int accepted, int bank,
+        struct ggml_tensor * dst) {
+    @autoreleasepool {
+        const int row_size = 128 * (heads + key_heads) + 2 * heads;
+        const int history_rows = history->ne[0] / row_size;
+        if (accepted < 1 || accepted > history_rows || bank < 0 || bank > 1) {
+            return false;
+        }
+
+        ggml_metal_library_t lib = ggml_metal_device_get_library(dev);
+        const char * name = "kernel_gated_delta_net_replay_export";
+        struct ggml_metal_pipeline_with_params pipeline = ggml_metal_library_get_pipeline(lib, name);
+        if (!pipeline.pipeline) {
+            pipeline = ggml_metal_library_compile_pipeline(lib, name, name, NULL);
+        }
+        if (!pipeline.pipeline) {
+            return false;
+        }
+
+        id<MTLCommandQueue> queue = ggml_metal_device_get_queue(dev);
+        id<MTLCommandBuffer> cmd = [queue commandBuffer];
+        if (!cmd) {
+            return false;
+        }
+        ggml_metal_encoder_t enc = ggml_metal_encoder_init(cmd, false);
+        if (!enc) {
+            return false;
+        }
+        ggml_metal_gdn_replay_export_args args = {{heads, key_heads, history_rows}, accepted, bank};
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes(enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(state), 1);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(history), 2);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(dst), 3);
+        ggml_metal_encoder_dispatch_threadgroups(enc, 32, heads, 1, 32, 4, 1);
+        ggml_metal_encoder_end_encoding(enc);
+        ggml_metal_encoder_free(enc);
+        [cmd commit];
+        [cmd waitUntilCompleted];
+        return cmd.status == MTLCommandBufferStatusCompleted;
+    }
+}
