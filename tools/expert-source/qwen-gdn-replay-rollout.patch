+        device float * dst [[buffer(3)]],
+        uint3 group [[threadgroup_position_in_grid]],
+        uint3 thread_id [[thread_position_in_threadgroup]]) {
+    const uint lane = thread_id.x;
+    const uint row = group.x * 4 + thread_id.y;
+    const uint head = group.y;
+    const uint row_size = 128 * (args.layout.heads + args.layout.key_heads) + 2 * args.layout.heads;
+    const uint offset = (head * 128 + row) * 128 + lane * 4;
+
+    float ls[4];
+    FOR_UNROLL (short j = 0; j < 4; ++j) {
+        ls[j] = state[offset + j];
+    }
+    gdn_replay_prefix(ls, history + args.bank * args.layout.history_rows * row_size,
+                      args.layout, args.accepted, lane, row, head);
+    FOR_UNROLL (short j = 0; j < 4; ++j) {
+        dst[offset + j] = ls[j];
+    }
+}
